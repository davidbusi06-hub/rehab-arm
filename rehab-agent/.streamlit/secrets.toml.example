# Copy this file to secrets.toml and fill in your key. secrets.toml is
# gitignored so the real key never gets committed.
#
# Used by the Training plan tab's "ElevenLabs (cloud)" transcription backend.
# app.py loads this value into ELEVENLABS_API_KEY at startup, which stt.py reads.
# Requires the ElevenLabs SDK:  pip install "elevenlabs>=1.0"
ELEVENLABS_API_KEY = "sk_your_key_here"
